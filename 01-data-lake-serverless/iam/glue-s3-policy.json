{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListarBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::SEU_BUCKET"
    },
    {
      "Sid": "LerRawEScripts",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "arn:aws:s3:::SEU_BUCKET/raw/*",
        "arn:aws:s3:::SEU_BUCKET/scripts/*"
      ]
    },
    {
      "Sid": "EscreverProcessed",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::SEU_BUCKET/processed/*"
    },
    {
      "Sid": "ArquivosTemporariosDoGlue",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::SEU_BUCKET/tmp/*"
    }
  ]
}
